	"description": "A direct binding system between players, villagers, and workstation blocks",
	"authors": [
		"Armaninyow"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/dibs",
		"sources": "https://github.com/armaninyow/Dibs",
		"issues": "https://github.com/armaninyow/Dibs/discussions/categories/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/dibs/icon.png",
